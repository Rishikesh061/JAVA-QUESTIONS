class BankAccount {
    int accountNumber;
    String accountHolderName;
    double balance;
    BankAccount(int accountNumber, String accountHolderName, double balance) {
        this.accountNumber = accountNumber;
        this.accountHolderName = accountHolderName;
        this.balance = balance;
    }
    synchronized void deposit(String userName, double amount) {
        balance = balance + amount;
        System.out.println(userName + " deposited: " + amount);
        System.out.println("Updated Balance: " + balance);
        System.out.println("--------------------------");
    }
    synchronized void withdraw(String userName, double amount) {
        if (balance >= amount) {
            balance = balance - amount;
            System.out.println(userName + " withdrawn: " + amount);
            System.out.println("Updated Balance: " + balance);
        } else {
            System.out.println(userName + ": Insufficient Balance");
        }
        System.out.println("--------------------------");
    }
    void displayBalance() {
        synchronized (this) {
            System.out.println("Account Number: " + accountNumber);
            System.out.println("Account Holder: " + accountHolderName);
            System.out.println("Final Balance: " + balance);
        }
    }
}
class UserTransaction extends Thread {
    BankAccount account;
    String userName;
    String transactionType;
    double amount;
    UserTransaction(BankAccount account, String userName,
                    String transactionType, double amount) {
        this.account = account;
        this.userName = userName;
        this.transactionType = transactionType;
        this.amount = amount;
    }
    public void run() {
        if (transactionType.equalsIgnoreCase("deposit")) {
            account.deposit(userName, amount);
        } else if (transactionType.equalsIgnoreCase("withdraw")) {
            account.withdraw(userName, amount);
        }
    }
}
public class Main {
    public static void main(String[] args) {
        BankAccount account = new BankAccount(101, "Rahul", 5000);
        UserTransaction t1 =
            new UserTransaction(account, "Priya", "deposit", 2000);
        UserTransaction t2 =
            new UserTransaction(account, "Amit", "withdraw", 1000);
        UserTransaction t3 =
            new UserTransaction(account, "Sneha", "withdraw", 3000);
        UserTransaction t4 =
            new UserTransaction(account, "Kiran", "deposit", 1500);
        t1.start();
        t2.start();
        t3.start();
        t4.start();
        try {
            t1.join();
            t2.join();
            t3.join();
            t4.join();
        } catch (InterruptedException e) {
            System.out.println("Transaction interrupted.");
            Thread.currentThread().interrupt();
            return;
        }
        System.out.println("\nAll transactions completed.");
        account.displayBalance();
    }
}
